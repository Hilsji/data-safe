# Kopieren nach .env und anpassen.

# --- Web ---
WEB_PORT=3000
# Upload-Grenzen
MAX_UPLOAD_BYTES=6442450944
MAX_CHUNK_BYTES=8388608
# Ergebnisse nach so vielen Tagen automatisch löschen
RESULT_TTL_DAYS=7
# Quiz frühestens so viele Minuten nach Ende der Aufnahme (ohne Klassen-Session)
DEFAULT_RETENTION_MIN=45

# --- Worker ---
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
WHISPER_MODEL=small
FRAMES_PER_SECOND=2
# ASR_DISABLED=1

# --- Strato (nur compose.strato.yml) ---
# DOMAIN=guide.meine-schule.de
