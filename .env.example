# Kopieren nach .env und anpassen.

# --- Web ---
WEB_PORT=3000
# Upload-Grenzen
MAX_UPLOAD_BYTES=6442450944
MAX_CHUNK_BYTES=8388608
# Ergebnisse nach so vielen Tagen automatisch löschen
RESULT_TTL_DAYS=7
# Quiz frühestens so viele Minuten nach Ende der Aufnahme (ohne Klassen-Session)
DEFAULT_RETENTION_MIN=45

# --- Anmeldung (Magic Link) ---
# Zufälliger Wert, mindestens 32 Zeichen, z. B. `openssl rand -base64 48`
AUTH_SECRET=
# Adresse, unter der die App erreichbar ist (für den Link in der Mail)
APP_URL=http://localhost:3000
# Wer sich anmelden darf – komma-getrennt
TEACHER_EMAIL_DOMAINS=meine-schule.de
TEACHER_EMAILS=
RATER_EMAILS=
ADMIN_EMAILS=
MAIL_FROM=Guide me <no-reply@meine-schule.de>
# SMTP_URL=smtps://user:passwort@smtp.strato.de:465   (Strato; lokal wird Mailpit genutzt)

# --- Worker ---
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
WHISPER_MODEL=small
FRAMES_PER_SECOND=2
# ASR_DISABLED=1

# --- Strato (nur compose.strato.yml) ---
# DOMAIN=guide.meine-schule.de
